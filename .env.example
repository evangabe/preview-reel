# See docs/spec.md §7.9 and README.md for what each of these does and
# how to obtain it. Validated at boot (R-CFG.1), not at point of use.

# Shown once when the team-level Vercel webhook is created.
VERCEL_WEBHOOK_SECRET=

# Comma-separated allowlist, e.g. me/preview-reel-target
PREVIEW_REEL_REPOS=

# Fine-grained PAT: Pull requests (read), Issues (write). Single repo.
GITHUB_TOKEN=

# Protection Bypass for Automation secret, per target Vercel project.
VERCEL_PROTECTION_BYPASS=

# Long-lived secret the target app trades for a session at
# /api/demo-login?token=...&next=...
DEMO_LOGIN_TOKEN=

# AI Gateway key, spend-capped.
AI_GATEWAY_API_KEY=

BLOB_READ_WRITE_TOKEN=

# For Sandbox provisioning: OIDC token or team token.
VERCEL_OIDC_TOKEN=
