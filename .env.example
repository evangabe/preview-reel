# See docs/setup.md for what each of these does and how to obtain it. Validated at boot (R-CFG.1), not at point of use.
#
# Only the variables in the first section belong in this file or in the
# Vercel dashboard. The second section is injected by the platform —
# setting those by hand shadows the injected value with a stale one.

# --- Set by hand ---------------------------------------------------

# Shown once when the team-level Vercel webhook is created. The webhook
# needs Preview Reel's production URL to exist, so this is necessarily
# blank on the first deploy.
VERCEL_WEBHOOK_SECRET=

# Comma-separated allowlist, e.g. me/preview-reel-target. Must not
# contain Preview Reel's own repo, or it processes its own deployments.
PREVIEW_REEL_REPOS=
# Optional Vercel project URL for the project link in the site header.
TARGET_VERCEL_PROJECT_URL=

# Fine-grained PAT: Pull requests (read), Issues (write). Single repo.
GITHUB_TOKEN=

# Protection Bypass for Automation secret, generated on the *target*
# project (Settings -> Deployment Protection) and copied here. Vercel
# injects it into the target's own deployments as
# VERCEL_AUTOMATION_BYPASS_SECRET; it is not injected into this one.
VERCEL_PROTECTION_BYPASS=

# Long-lived secret the target app trades for a session at
# /api/demo-login?token=...&next=...
DEMO_LOGIN_TOKEN=

# AI Gateway key, spend-capped:
#   vercel ai-gateway api-keys create --name preview-reel \
#     --budget 25 --refresh-period monthly
AI_GATEWAY_API_KEY=

# Public production alias used in PR comments and status links.
APP_BASE_URL=https://preview-reel.vercel.app

# Immutable snapshot built by `npx tsx scripts/build-snapshot.ts`. Store the
# printed ID as a readable Config value in all three Vercel environments.
SANDBOX_SNAPSHOT_ID=

# --- Injected by Vercel; do not set in the dashboard -----------------
#
# BLOB_READ_WRITE_TOKEN   appears once a Blob store is connected to the
#                         project (Storage -> Blob -> Connect Project).
#                         Present at build time and at runtime.
#
# VERCEL_OIDC_TOKEN       build-time and local-development only. Deployed
#                         functions never see it on process.env — the
#                         Sandbox SDK acquires it out of band — so it is
#                         not validated at boot on Vercel. Locally,
#                         `vercel env pull` writes it to .env.local and it
#                         expires after 12 hours; re-pull on Sandbox auth
#                         errors. Requires Settings -> Security -> Secure
#                         backend access with OIDC federation (on by
#                         default for new projects).
